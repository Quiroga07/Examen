{
    "name": "examen/ubl-xsd-poc",
    "description": "Isolated UBL 2.1 Invoice schema generation proof of concept",
    "type": "project",
    "require": {
        "php": "^8.2",
        "goetas-webservices/xsd2php": "0.4.14",
        "goetas-webservices/xsd2php-runtime": "0.2.18",
        "jms/serializer": "^3.32"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "Ubl21\\": "generated/php/",
            "Ubl21Poc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ubl21Poc\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
